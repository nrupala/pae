# PAE Python API Server
# Runs the FastAPI server for data persistence, CSV import, and analytics proxy.
#
# Usage:
#   docker build -f infra/docker/Dockerfile.python -t pae-api .
#   docker run -p 3002:3002 -v pae-data:/app/data -e PAE_ENGINE_URL=http://engine:3001 pae-api

FROM python:3.12-slim-bookworm

ENV APP_ROOT=/app
ENV PAE_DB_PATH=/app/data/pae.db
ENV PAE_ENGINE_URL=http://localhost:3001

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR ${APP_ROOT}

COPY analytics/ ./analytics/
RUN pip install --no-cache-dir ./analytics

RUN mkdir -p /app/data

EXPOSE 3002

HEALTHCHECK --interval=30s --timeout=5s --retries=3 \
    CMD curl -f http://localhost:3002/health || exit 1

CMD ["uvicorn", "pae.server:app", "--host", "0.0.0.0", "--port", "3002"]
